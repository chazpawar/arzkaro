# Supabase Configuration
# Get these values from your Supabase project settings:
# 1. Go to https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
# 2. Copy the Project URL and anon/public key

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client IDs for iOS and Android
# 3. For Web (used for redirect), use the Supabase callback URL

# iOS Client ID (from Google Cloud Console - iOS application type)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Android Client ID (from Google Cloud Console - Android application type)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Web Client ID (from Google Cloud Console - Web application type)
# This is used for the OAuth redirect flow
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Razorpay Configuration
# Get these from Razorpay Dashboard:
# 1. Go to https://dashboard.razorpay.com/app/keys
# 2. Copy the Key ID and Key Secret
# Note: Use Test keys for development and Live keys for production

EXPO_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Google Maps & Places API Configuration
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/google/maps-apis
# 2. Enable the following APIs:
#    - Maps SDK for Android
#    - Maps SDK for iOS  
#    - Places API
#    - Geocoding API
# 3. Create an API key from Credentials page
# 4. Restrict the key to your app's bundle ID/package name
# Note: Billing must be enabled for Places API and Geocoding API

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
